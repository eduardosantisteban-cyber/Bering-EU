# Contraseña única compartida por el equipo para entrar en la app
APP_PASSWORD=

# Secreto usado para firmar la cookie de sesión (cualquier cadena larga
# y aleatoria, p. ej. generada con `openssl rand -hex 32`)
SESSION_SECRET=

# Proyecto de Supabase (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mismo proyecto, clave pública (Settings -> API -> anon public). Se usa
# SOLO en el navegador para subir el PDF directo a Supabase Storage con una
# signed upload URL de un solo uso (evita el límite de tamaño de payload de
# las funciones de Vercel). La clave anon no da acceso a nada por sí sola:
# las tablas están protegidas por RLS y en Storage solo sirve para
# completar, vía un PUT normal, una subida ya autorizada por el backend con
# la service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Holded (CRM) -> ajustes de la cuenta -> API. Solo se usa en el servidor,
# para crear el presupuesto ("estimate") al pulsar "Crear presupuesto en
# Holded" desde el Cotizador. Opcional: si no se configura, el resto de la
# app funciona igual, solo falla ese botón.
HOLDED_API_KEY=

# Cuenta de servicio de Google Cloud (JSON completo, codificado en base64)
# con acceso a las API de Sheets y Drive. Se usa SOLO en el servidor, para
# crear el botón "Google Sheet" del Cotizador. Ver README > "Google Sheet
# desde el Cotizador" para cómo generarla y compartir la Unidad compartida
# con ella. Opcional: sin ella, el resto de la app funciona igual, solo
# falla ese botón.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ID de la Unidad compartida (o carpeta dentro de ella) donde se crean las
# hojas nuevas. Es el trozo de la URL después de /folders/ al abrirla en
# Drive. Opcional: si se omite, Drive intentará crear la hoja en el Drive
# propio de la cuenta de servicio (que nadie del equipo puede ver), así
# que en la práctica hace falta rellenarlo.
GOOGLE_DRIVE_FOLDER_ID=
