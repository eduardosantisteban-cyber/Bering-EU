# Contraseña única compartida por el equipo para entrar en la app
APP_PASSWORD=

# Secreto usado para firmar la cookie de sesión (cualquier cadena larga
# y aleatoria, p. ej. generada con `openssl rand -hex 32`)
SESSION_SECRET=

# Proyecto de Supabase (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mismo proyecto, claves públicas (Settings -> API -> Project URL / anon public).
# Se usan SOLO en el navegador para subir el PDF directo a Supabase Storage
# con una signed upload URL de un solo uso (evita el límite de tamaño de
# payload de las funciones de Vercel). La clave anon no da acceso a nada
# por sí sola: las tablas están protegidas por RLS y en Storage solo sirve
# para completar una subida ya autorizada por el backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
